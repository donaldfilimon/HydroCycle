# Export overrides in the shell before running HydroCycle. This file is a
# reference only; development scripts do not load it automatically.
HYDROCYCLE_API_PORT=8000
HYDROCYCLE_WEB_PORT=5173

# Used by the standalone `uv run hydrocycle-model` command.
HYDROCYCLE_PORT=8000

# Relative database paths are resolved from the repository root.
HYDROCYCLE_DB_PATH=data/hydrocycle.db
HYDROCYCLE_ATTACHMENTS_DIR=data/attachments

# Advanced alternative to HYDROCYCLE_DB_PATH, primarily for isolated tests.
# HYDROCYCLE_DATABASE_URL=sqlite+pysqlite:////absolute/path/hydrocycle.db
