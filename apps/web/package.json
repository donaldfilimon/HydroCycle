{
  "name": "@hydrocycle/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "HYDROCYCLE_WEB_MODE=local next dev --hostname 127.0.0.1 --port 5173",
    "build": "bun run build:local",
    "build:local": "HYDROCYCLE_WEB_MODE=local HYDROCYCLE_DEPLOY_TARGET=local next build",
    "build:hosted": "HYDROCYCLE_WEB_MODE=hosted HYDROCYCLE_DEPLOY_TARGET=pages next build",
    "build:sites": "HYDROCYCLE_WEB_MODE=hosted HYDROCYCLE_DEPLOY_TARGET=sites vinext build",
    "start": "bun run start:local",
    "start:local": "HYDROCYCLE_WEB_MODE=local next start --hostname 127.0.0.1 --port 4173",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "visual:capture": "bun scripts/capture-visuals.ts",
    "check:hosted-artifact": "bun scripts/check-hosted-artifact.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build:local && bun run build:hosted && bun run check:hosted-artifact"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.93",
    "@base-ui/react": "1.7.0",
    "@hydrocycle/advisor": "workspace:*",
    "@hydrocycle/contracts": "workspace:*",
    "@hydrocycle/view-model": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "motion": "13.1.1",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "9.35.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.16",
    "vitest": "3.2.4",
    "wrangler": "4.92.0"
  }
}
