{
  "name": "@hydrocycle/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --localhost",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --localhost --ios",
    "android": "EXPO_NO_TELEMETRY=1 expo start --localhost --android",
    "acceptance:ios": "bash ../../scripts/mobile-acceptance.sh ios",
    "acceptance:android": "bash ../../scripts/mobile-acceptance.sh android",
    "export:simulator-bundles": "bash ../../scripts/release-mobile-simulators.sh",
    "check:loopback": "node ./scripts/check-loopback-listener.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "EXPO_NO_TELEMETRY=1 jest --runInBand",
    "check": "bun run check:loopback && bun run typecheck && bun run lint && bun run test"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^@hydrocycle/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
      "^@hydrocycle/view-model$": "<rootDir>/../../packages/view-model/src/index.ts"
    }
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "openapi-fetch": "^0.14.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  }
}
