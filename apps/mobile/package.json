{
  "name": "@hydrocycle/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "EXPO_NO_TELEMETRY=1 jest --runInBand",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^@hydrocycle/contracts$": "<rootDir>/../../packages/contracts/src/index.ts"
    }
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-status-bar": "~2.2.3",
    "openapi-fetch": "^0.14.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-safe-area-context": "5.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  }
}
