{
  "name": "hydrocycle",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/web",
    "packages/*",
    "services/gateway"
  ],
  "scripts": {
    "setup": "bun install --frozen-lockfile && uv lock --check --project services/model && uv sync --frozen --project services/model",
    "dev": "bun run dev:local",
    "dev:local": "bash scripts/dev.sh",
    "build": "bun run build:local",
    "build:local": "bun run --cwd apps/web build:local",
    "build:hosted": "bun run --cwd apps/web build:hosted",
    "build:pages": "bun run build:hosted",
    "build:sites": "bun run --cwd apps/web build:sites",
    "start:local": "bun run --cwd apps/web start:local",
    "check:gateway": "bun run --cwd services/gateway check",
    "check:hosted-artifact": "bun run --cwd apps/web check:hosted-artifact",
    "check": "bash scripts/check.sh",
    "check:web": "bun run --cwd apps/web check",
    "check:mobile": "bash scripts/check-mobile.sh",
    "check:model": "bash scripts/check-model.sh",
    "test": "bun run test:model && bun run test:contracts && bun run test:view-model && bun run test:web",
    "test:model": "uv run --project services/model --frozen pytest",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:view-model": "bun run --cwd packages/view-model test",
    "test:web": "bun run --cwd apps/web test",
    "test:gateway": "bun run --cwd services/gateway test",
    "contracts": "bash scripts/generate-contracts.sh",
    "contracts:check": "bash scripts/check-contracts.sh",
    "test:e2e:install": "bun run --cwd apps/web test:e2e:install",
    "test:e2e": "bun run --cwd apps/web test:e2e"
  }
}
